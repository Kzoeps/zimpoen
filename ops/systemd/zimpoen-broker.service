# zimpoen-broker: runs the credential broker's policy actions with secrets the server never sees (docs/OPS.md "Broker").
#
# Not installed by ops/install-units.sh. Install by hand (docs/OPS.md "Broker"): create the zimpoen-broker user and group,
# add the server's user to the group, encrypt each secret with systemd-creds, fill in the lines marked CHANGE, then
#   sudo install -m 0644 ops/systemd/zimpoen-broker.service /etc/systemd/system/ && sudo systemctl daemon-reload
#   sudo systemctl enable --now zimpoen-broker
# and set ZIMPOEN_CRED_BROKER=socket in /etc/assistant/assistant.env. Start it before the server: the server asks it for
# the policy at start and stops if it can't reach it.
# Logs: journalctl -u zimpoen-broker -f
[Unit]
Description=zimpoen credential broker
Before=assistant-server.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=zimpoen-broker
Group=zimpoen-broker
# CHANGE: the repository checkout (built with `pnpm build`). zimpoen-broker must be able to read it.
WorkingDirectory=/opt/assistant
Environment=NODE_ENV=production
# The socket's directory is the access check (Node has no SO_PEERCRED): /run/zimpoen-broker, owned by
# zimpoen-broker:zimpoen-broker, mode 0750. Only members of the group (the server's user) can reach the socket.
RuntimeDirectory=zimpoen-broker
RuntimeDirectoryMode=0750
Environment=ZIMPOEN_BROKER_SOCKET=/run/zimpoen-broker/broker.sock
# The policy, owner-written, readable by the broker: /etc/zimpoen-broker/policy.json (root:zimpoen-broker 0640).
ConfigurationDirectory=zimpoen-broker
ConfigurationDirectoryMode=0750
Environment=ZIMPOEN_CRED_POLICY=/etc/zimpoen-broker/policy.json
# Its own append-only run log, separate from the server's decision log.
StateDirectory=zimpoen-broker
StateDirectoryMode=0700
Environment=ZIMPOEN_BROKER_AUDIT=/var/lib/zimpoen-broker/audit.jsonl
Environment=ZIMPOEN_BROKER_SECRETS=systemd-creds
# CHANGE: one line per secretRef in the policy. Encrypt with:
#   sudo systemd-creds encrypt --name=<ref> - /etc/credstore.encrypted/<ref>   (type the value, then Ctrl-D)
# systemd decrypts it into $CREDENTIALS_DIRECTORY/<ref>, readable by this service only.
LoadCredentialEncrypted=gh-token:/etc/credstore.encrypted/gh-token
# CHANGE: the absolute path of Node 24.
ExecStart=/usr/bin/node apps/server/dist/broker.js
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
# A running action is killed with the service; its own timeout is at most 10 minutes.
TimeoutStopSec=15

# Hardening. Actions run programs (gh, git) that need the network, so it is not cut off.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077

[Install]
WantedBy=multi-user.target
