{
	"name": "@assistant/server",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Long-running Node process: Durable Harness, app.sqlite, HTTP API and SSE",
	"scripts": {
		"dev": "cd ../.. && env ASSISTANT_AUTH=${ASSISTANT_AUTH:-off} node --watch apps/server/src/main.ts",
		"build": "node scripts/build.mjs",
		"start": "cd ../.. && env NODE_ENV=production node apps/server/dist/main.js",
		"typecheck": "tsc --noEmit",
		"connect:google": "cd ../.. && env NODE_ENV=production node apps/server/src/connect-google.ts",
		"login:openai": "cd ../.. && env NODE_ENV=production node apps/server/src/login-openai.ts",
		"logout:openai": "cd ../.. && env NODE_ENV=production node apps/server/src/logout-openai.ts"
	},
	"dependencies": {
		"@assistant/db": "workspace:*",
		"@assistant/extensions": "workspace:*",
		"@assistant/shared": "workspace:*",
		"@earendil-works/chord": "1.4.0",
		"@earendil-works/pi-ai": "1.4.0",
		"@earendil-works/pi-codemode": "1.4.0",
		"@earendil-works/pi-durable": "1.4.0",
		"@hono/node-server": "2.1.5",
		"@modelcontextprotocol/sdk": "1.32.1",
		"hono": "4.13.13",
		"mustache": "4.2.0",
		"pdfkit": "0.20.2",
		"pi-web-access": "0.38.0",
		"web-push": "3.6.7"
	},
	"devDependencies": {
		"@types/web-push": "3.6.4",
		"esbuild": "0.28.2"
	}
}
