# Settings of the assistant, one KEY=value per line (systemd's EnvironmentFile format: no `export`, no quotes needed).
#
#   sudo install -d -m 0750 -o root -g "$(id -gn)" /etc/assistant
#   sudo install -m 0600 -o "$USER" -g "$(id -gn)" ops/assistant.env.example /etc/assistant/assistant.env
#   sudoedit /etc/assistant/assistant.env
# The folder is readable by your group and the file is yours, so that you can read it (ops/check.sh --env-file does); systemd reads it as root.
#
# The file may hold nothing secret: the OpenAI sign-in, the Google sign-ins and the Jev key live in <data>/secrets/.
# Every variable is explained in README.md ("Configuration"). NODE_ENV=production is set by the unit files, not here.

# --- required: replace all three. The values below are examples: the server accepts them, and ops/check.sh fails on them. ---------
# Your Tailscale login: the only identity the server lets in. ops/tailscale-serve.sh prints it (the admin console shows it as the
# "Owner" of this machine).
ASSISTANT_OWNER_LOGIN=you@example.com
# The name you open the assistant by over Tailscale (printed by ops/tailscale-serve.sh).
ASSISTANT_PUBLIC_HOST=my-laptop.tail1234.ts.net
# A contact the push services may use to reach you (the VAPID `sub` claim).
ASSISTANT_PUSH_SUBJECT=mailto:you@example.com

# --- where things are ---------------------------------------------------------------------------------------------
# Absolute path of the data directory (databases, uploads, secrets). The default, ./data, is relative to the unit's WorkingDirectory.
# Whatever you set here must also be in ReadWritePaths= of assistant-server.service.
#ASSISTANT_DATA_DIR=/home/you/assistant-data
# Folders the assistant may read (absolute, separated by ':'). Default: ~/Documents:~/Downloads of the service user.
#ASSISTANT_READ_PATHS=/home/you/Documents:/home/you/Downloads

# --- about you ----------------------------------------------------------------------------------------------------
#ASSISTANT_OWNER_NAME=Dorje
#ASSISTANT_TIMEZONE=Asia/Thimphu
#ASSISTANT_CURRENCY=BTN
# Only the Health agent is told it (for the BMI).
#ASSISTANT_OWNER_HEIGHT_CM=176

# --- tuning (the defaults are what the checklist assumes) ---------------------------------------------------------
#ASSISTANT_INBOX_SYNC_MINUTES=10
#ASSISTANT_PORT=3001
